{
  "name": "healim-clinic-bupyeong",
  "version": "1.0.0",
  "private": true,
  "description": "해아림한의원 부평점 통증·추나·교통사고·보약·담적 통합진료센터",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --minify",
    "new:column": "node scripts/new-column.js",
    "publish:slot": "node scripts/auto-publish-slot.js",
    "publish:all": "node scripts/auto-publish-slot.js --all",
    "publish:auto": "node scripts/publish-and-deploy.js",
    "publish:daemon": "node scripts/publish-daemon.js",
    "deploy": "hugo --minify && npx wrangler pages deploy public --project-name=healimbp --branch=main --commit-dirty=true",
    "send:telegram": "node scripts/send-to-telegram.js",
    "thumbnails:build": "node scripts/build-all-exact-thumbnails.js",
    "validate": "node scripts/validate_all_articles.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}
